# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Load into a shell with:  set -a; . ./.env; set +a

OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
KILO_API_KEY=                     # optional: Kilo's free routes also work keyless

# Optional: comma-separate multiple keys per provider via FREELM_<PROVIDER>_KEYS
# FREELM_OPENROUTER_KEYS=key1,key2

# Optional tiers
# FREELM_OPENROUTER_TIER=free      # free | credit
# FREELM_GOOGLE_TIER=free          # free | tier1

# Optional: persist quota/cooldown/disabled-key state across restarts
# (~/.cache/freelm/state.json — key hashes only, never raw keys)
# FREELM_PERSIST=1

# Optional: `freelm serve` (local OpenAI-compatible endpoint)
# FREELM_PORT=4000
# FREELM_HOST=127.0.0.1
# FREELM_SERVER_KEY=          # require this bearer token from clients

# Keyless public endpoints (Kilo Gateway, OVHcloud) — no signup, low limits,
# free routes may log prompts. Library default: off. CLI default: auto.
# FREELM_KEYLESS=1                # 1 = always as last resort | auto = only when no keys | 0 = never

# Check which keys actually work:  freelm doctor
